# Copia este archivo a ".env" (junto a package.json) y ajusta lo que necesites.
# Nebula lo lee solo al arrancar con `npm start`; no hace falta usar `set` en cada sesión.

PORT=3000
# 127.0.0.1 = solo este equipo · 0.0.0.0 = toda la red (usa HTTPS o un proxy inverso)
HOST=127.0.0.1
DATA_DIR=./data

# Carpetas iniciales (también se pueden añadir desde Ajustes)
#MOVIES_DIR=D:\Peliculas
#SERIES_DIR=D:\Series

# Carátulas y sinopsis (opcional)
#TMDB_API_KEY=
#TMDB_LANGUAGE=es-ES

# HTTPS directo (opcional): certificado y clave en formato PEM
#TLS_CERT=C:\nebula\certs\nebula.pem
#TLS_KEY=C:\nebula\certs\nebula-key.pem
# Detrás de un proxy inverso (Caddy, nginx…): pon 1 para que la IP y el protocolo sean los reales
#TRUST_PROXY=1

# Vigilancia de carpetas: 0 la desactiva. Si tus carpetas están en red, activa el escaneo periódico.
#WATCH=1
#SCAN_INTERVAL_MINUTES=30

#MAX_TRANSCODES=3

# Descargas (qBittorrent): interfaz web de qBittorrent, solo en este equipo
#TORRENT_URL=http://127.0.0.1:8080
#TORRENT_USER=
#TORRENT_PASS=
# Espacio (GB) que debe quedar libre para aceptar una descarga nueva
#TORRENT_MIN_FREE_GB=5

# Buscador de torrents en la pestaña Descargas: Prowlarr instalado en este equipo.
# La API key está en Prowlarr → Settings → General → Security.
#PROWLARR_URL=http://127.0.0.1:9696
#PROWLARR_API_KEY=
