{
  "name": "nebula",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "doctor": "npm run doctor -w backend",
    "start": "npm run build && npm run start -w backend",
    "torrents:doctor": "npm run torrents:doctor -w backend",
    "tokens": "npm run tokens -w frontend"
  }
}
